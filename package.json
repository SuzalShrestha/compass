{
  "name": "compass",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A purposeful new tab page — tasks, calendar, long-term goals, reading, habits and a focus timer, with a daily Stoic quote.",
  "license": "MIT",
  "author": "Sujal Shrestha",
  "packageManager": "pnpm@10.32.1",
  "homepage": "https://github.com/SuzalShrestha/compass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuzalShrestha/compass.git"
  },
  "bugs": {
    "url": "https://github.com/SuzalShrestha/compass/issues"
  },
  "keywords": [
    "chrome-extension",
    "new-tab",
    "productivity",
    "obsidian",
    "react",
    "manifest-v3",
    "time-tracking"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
